# Application Setup
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

# Database Connection (MySQL)
DATABASE_URL="mysql://root:password@localhost:3306/health_sakhi"

# JWT Auth Configuration
JWT_SECRET="super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="30d"

# Logging Setup
LOG_LEVEL="info"

# Nodemailer SMTP Configuration
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="health sakhi -reply@healthsakhi.com>"

# Storage (AWS S3) Setup
S3_BUCKET_NAME="health-sakhi-assets"
S3_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# OpenAI Configuration (For AI Companion, Memory extraction, and Crisis detection)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Gemini Configuration (Alternative Provider)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

